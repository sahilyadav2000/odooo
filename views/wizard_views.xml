<odoo>
    <record id="view_reject_wizard" model="ir.ui.view">
        <field name="model">reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Reject" class="btn-danger"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>