<odoo>

    <!-- LIST VIEW -->
    <record id="view_category_list" model="ir.ui.view">
        <field name="name">approval.category.list</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_category_form" model="ir.ui.view">
        <field name="name">approval.category.form</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <form string="Approval Category">

                <sheet>

                    
                    <group>
                        <field name="name"/>
                    </group>

                    
                    <group string="Field Visibility">
                        <field name="show_product"/>
                        <field name="show_qty"/>
                        <field name="show_amount"/>
                        <field name="show_partner"/>
                        <field name="show_document"/>
                    </group>

                    
                    <notebook>

                        <!-- APPROVERS -->
                        <page string="Approval Request Managers">
                            <field name="approval_line_ids"
                                   domain="[('role','=','approve')]">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- REJECTORS -->
                        <page string="Reject Request Managers">
                            <field name="approval_line_ids"
                                   domain="[('role','=','reject')]">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Approval Request Categories</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>